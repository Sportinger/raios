{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:raios:hardware:schema:register-map:v1",
  "title": "raiOS owned-device register map v1",
  "type": "object",
  "required": ["schema", "mapVersion", "id", "device", "provenance", "registers"],
  "properties": {
    "schema": { "const": "urn:raios:hardware:schema:register-map:v1" },
    "mapVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "device": {
      "type": "object",
      "required": ["bus", "identity", "bar", "ownedRegions"],
      "properties": {
        "bus": { "const": "pci" },
        "identity": { "type": "object", "minProperties": 1 },
        "bar": {
          "type": "object",
          "required": ["index", "addressSpace"],
          "properties": {
            "index": { "type": "integer", "minimum": 0, "maximum": 5 },
            "addressSpace": { "const": "mmio" }
          },
          "additionalProperties": true
        },
        "ownedRegions": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "base", "length"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "base": { "type": "object", "required": ["kind"] },
              "length": { "type": "integer", "minimum": 1 },
              "stride": { "type": "integer", "minimum": 1 },
              "countSource": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "path", "claim"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["raios-source", "linux-source", "public-specification"] },
          "path": { "type": "string", "minLength": 1 },
          "lines": { "type": "string" },
          "claim": { "type": "string", "minLength": 1 }
        }
      }
    },
    "constants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "kind", "meaning", "provenance"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": "integer", "minimum": 0 },
          "kind": { "enum": ["command-opcode", "shift", "descriptor-mask", "ring-mask", "ring-parameter", "buffer-parameter", "region-offset", "region-stride"] },
          "meaning": { "type": "string", "minLength": 1 },
          "provenance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "registers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "region", "offset", "width", "access", "semantics", "provenance"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "region": { "type": "string", "minLength": 1 },
          "offset": { "type": "integer", "minimum": 0 },
          "width": { "enum": [8, 16, 32, 64] },
          "access": { "enum": ["ro", "rw", "wo", "w1c", "rwc", "mixed"] },
          "aliasGroup": { "type": "string", "minLength": 1 },
          "instances": { "type": "object" },
          "semantics": {
            "type": "object",
            "required": ["status", "description"],
            "properties": {
              "status": { "enum": ["documented", "source-derived", "unknown"] },
              "description": { "type": "string", "minLength": 1 },
              "bitfields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "mask", "meaning"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "mask": { "type": "integer", "minimum": 1 },
                    "meaning": { "type": "string", "minLength": 1 },
                    "overlapGroup": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "constants": { "type": "array" }
            }
          },
          "provenance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  },
  "additionalProperties": false
}
