{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raios.local/schemas/machine-manifest.v1.json",
  "title": "raiOS machine manifest v1",
  "type": "object",
  "maxProperties": 7,
  "additionalProperties": false,
  "required": ["schema_version", "curated_context_ready", "missing_required_facts", "machine", "cpu", "memory", "devices"],
  "properties": {
    "schema_version": { "const": "raios.machine_manifest.v1" },
    "curated_context_ready": { "type": "boolean" },
    "missing_required_facts": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/factPath" }
    },
    "machine": {
      "type": "object",
      "maxProperties": 4,
      "additionalProperties": false,
      "required": ["id", "kind", "display_name", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "kind": { "enum": ["virtual", "physical"] },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "cpu": {
      "type": "object",
      "maxProperties": 3,
      "additionalProperties": false,
      "required": ["architecture", "model", "features"],
      "properties": {
        "architecture": { "$ref": "#/$defs/stringFact" },
        "model": { "$ref": "#/$defs/stringFact" },
        "features": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/booleanFact" }
        }
      }
    },
    "memory": {
      "type": "object",
      "maxProperties": 3,
      "additionalProperties": false,
      "required": ["total_bytes", "topology", "regions"],
      "properties": {
        "total_bytes": { "$ref": "#/$defs/integerFact" },
        "topology": { "$ref": "#/$defs/stringFact" },
        "regions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/region" }
        }
      }
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/device" }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "factPath": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^/(cpu/(architecture|model|features/[a-z0-9][a-z0-9._-]*)|memory/(total_bytes|topology|regions/[a-z0-9][a-z0-9._-]*)|devices/[a-z0-9][a-z0-9._-]*/(identity|bdf|resources/[0-9]+))$"
    },
    "provenance": {
      "type": "object",
      "maxProperties": 4,
      "additionalProperties": false,
      "required": ["machine_id", "source_kind", "source_ref", "observed_at_utc"],
      "properties": {
        "machine_id": { "$ref": "#/$defs/stableId" },
        "source_kind": { "enum": ["launch_configuration", "boot_observation", "documentation_gap"] },
        "source_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
        "observed_at_utc": { "type": "string", "maxLength": 64, "format": "date-time" }
      }
    },
    "stringFact": {
      "type": "object",
      "maxProperties": 3,
      "additionalProperties": false,
      "required": ["status", "value", "provenance"],
      "properties": {
        "status": { "enum": ["observed", "unknown"] },
        "value": { "type": ["string", "null"], "minLength": 1, "maxLength": 1024 },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "integerFact": {
      "type": "object",
      "maxProperties": 3,
      "additionalProperties": false,
      "required": ["status", "value", "provenance"],
      "properties": {
        "status": { "enum": ["observed", "unknown"] },
        "value": { "type": ["integer", "null"], "minimum": 0 },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "booleanFact": {
      "type": "object",
      "maxProperties": 4,
      "additionalProperties": false,
      "required": ["name", "status", "value", "provenance"],
      "properties": {
        "name": { "$ref": "#/$defs/stableId" },
        "status": { "enum": ["observed", "unknown"] },
        "value": { "type": ["boolean", "null"] },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "region": {
      "type": "object",
      "maxProperties": 6,
      "additionalProperties": false,
      "required": ["id", "kind", "start_bytes", "length_bytes", "status", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "kind": { "enum": ["ram", "reserved", "mmio", "firmware", "unknown"] },
        "start_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "length_bytes": { "type": ["integer", "null"], "minimum": 1 },
        "status": { "enum": ["observed", "unknown"] },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "device": {
      "type": "object",
      "maxProperties": 6,
      "additionalProperties": false,
      "required": ["id", "type", "identity", "bdf", "resources", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "type": { "enum": ["chipset", "storage", "network", "usb_controller", "usb_input", "display", "rng", "firmware", "other"] },
        "identity": { "$ref": "#/$defs/stringFact" },
        "bdf": { "$ref": "#/$defs/bdfFact" },
        "resources": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/resource" } },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "bdfFact": {
      "type": "object",
      "maxProperties": 3,
      "additionalProperties": false,
      "required": ["status", "value", "provenance"],
      "properties": {
        "status": { "enum": ["observed", "unknown"] },
        "value": { "type": ["string", "null"], "maxLength": 12, "pattern": "^[0-9a-fA-F]{4}:[0-9a-fA-F]{2}:[0-1][0-9a-fA-F]\\.[0-7]$" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "resource": {
      "type": "object",
      "maxProperties": 5,
      "additionalProperties": false,
      "required": ["kind", "start", "length", "status", "provenance"],
      "properties": {
        "kind": { "enum": ["mmio", "io_port", "irq", "dma", "unknown"] },
        "start": { "type": ["integer", "null"], "minimum": 0 },
        "length": { "type": ["integer", "null"], "minimum": 1 },
        "status": { "enum": ["observed", "unknown"] },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    }
  }
}
